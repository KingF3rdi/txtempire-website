# Shop Backend
DATABASE_URL=sqlite+aiosqlite:///./shop.db
SECRET_KEY=change-me-in-production
BOT_API_KEY=change-bot-api-key

# Discord OAuth (gleiche App wie dein Discord Bot)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TICKET_CATEGORY_ID=

DISCORD_GUILD_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_PURCHASE_LOG_CHANNEL_ID=
DISCORD_VOUCH_CHANNEL_ID=
DISCORD_INVITE_URL=https://discord.gg/UjH99aR5ph

FRONTEND_URL=http://localhost:3000

# Admin panel — comma-separated Discord user IDs
ADMIN_DISCORD_IDS=

# Bot Minecraft account — link codes + payment recipient (/pay)
SHOP_BOT_IGN=ShopBot
# Optional override if payments go to a different IGN than the bot
# SHOP_OWNER_IGN=

# --- Discord bot integration (github.com/KingF3rdi/txtempire-shop-bot) ---
# The Discord bot runs as its own separate deployment, not part of this repo.
# In the bot's own .env, set:
#   SHOP_API_URL   = the public URL this backend is deployed at
#   BOT_API_KEY    = same value as BOT_API_KEY above
#   DISCORD_TOKEN  = same value as DISCORD_BOT_TOKEN above
#   GUILD_ID       = same value as DISCORD_GUILD_ID above
#   MC_LINK_IGN    = same value as SHOP_BOT_IGN above
# The bot syncs the catalog on startup/`/syncshop`, forwards ingame link codes
# and payments it receives from the Minecraft mod to /api/bot/*, and always
# finalizes purchases inside a Discord ticket — this backend never confirms a
# sale on its own.
#
# Players install the Fabric mod (mods/txtempire-mc-watcher-<version>.jar) to
# link their account and report payments ingame. The mod talks directly to the
# bot's own HTTP API (default http://<bot-host>:8765), not to this backend —
# point its `apiUrl` config at wherever the Discord bot is hosted.

# Rate limits (requests per window in seconds)
RATE_LIMIT_DEFAULT_MAX=120
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_SEARCH_MAX=40
RATE_LIMIT_SEARCH_WINDOW=60
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WRITE_WINDOW=60
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AUTH_WINDOW=60
